NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional. The site's public address, used in sign-in redirect links (defaults to the request's origin).
NEXT_PUBLIC_SITE_URL=
# Optional. "true" shows magic-link sign-in and password reset; needs an email sender (SMTP) set up in Supabase.
NEXT_PUBLIC_EMAIL_LINKS=false
# Optional. Comma-separated OAuth buttons to show (google, github); each must be enabled in Supabase.
NEXT_PUBLIC_OAUTH_PROVIDERS=
